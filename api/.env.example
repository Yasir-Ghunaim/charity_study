# Copy to .env (never commit .env). All optional: with nothing set the agent
# uses a local Ollama model if one is running, else simple rules.

# ChatGPT (OpenAI). OPENAI_MODEL has no default: use a model name from your OpenAI dashboard.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=...
# OPENAI_BASE_URL=...        optional: any OpenAI-compatible provider (Gemini, Groq, OpenRouter…)

# Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Local model via Ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# auto (default) = ChatGPT, else Claude, else Ollama, else rules, whichever is configured first
# AGENT_PROVIDER=auto

# Search by meaning (embeddings). Needs: ollama pull bge-m3
# Without it, search falls back to Arabic-aware keyword matching.
# EMBED_MODEL=bge-m3

# ---- study
# Where participant data is stored. Unset = local file api/data/study.db.
# For any hosted deployment use Postgres (e.g. Neon), since free hosts wipe their disk:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Protects /api/study/admin/* (summary and CSV exports). Required to export data.
# STUDY_ADMIN_TOKEN=change-me-to-a-long-random-string
# Shown in the consent form:
# STUDY_CONTACT_AR=...
# STUDY_CONTACT_EN=...
# For a real study, fix the engine so every participant gets the same assistant:
# AGENT_PROVIDER=openai
